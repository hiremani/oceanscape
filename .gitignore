__pycache__/
node_modules/
*.pyc
# NPU detector: Rockchip's runtime and header (tools/npu/fetch_rknn.sh) and the converted model
# (tools/npu/convert_model.sh) are fetched or built, never committed
android/app/src/main/jniLibs/arm64-v8a/librknnrt.so
android/app/src/main/cpp/third_party/
android/app/src/main/assets/npu/*.rknn
